<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:padding="24dp">

    <ImageButton
        android:id="@+id/btn_help"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_help"
        android:stateListAnimator="@animator/icon_btn_elevation"
        app:tint="#94A3B8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/btn_logout"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_logout"
        android:stateListAnimator="@animator/icon_btn_elevation"
        app:tint="#F43F5E"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tv_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="90dp"
        android:text="SUDOKU"
        android:textSize="50sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.15"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="6"
        android:shadowRadius="8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_logo"
        app:layout_constraintBottom_toTopOf="@id/tv_author"
        app:layout_constraintVertical_bias="0.45">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_play"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_btn_play"
            android:text="Thử thách ngay"
            android:textAllCaps="false"
            android:textColor="#0B0A0A"
            android:textSize="19sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_game_play"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:drawablePadding="16dp"
            android:gravity="center_vertical|start"
            android:elevation="6dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_btn_stats"
            android:text="Thống kê chi tiết"
            android:textAllCaps="false"
            android:textColor="#0E0F0F"
            android:textSize="19sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_chart_stats"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:drawablePadding="16dp"
            android:gravity="center_vertical|start"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="By TBT"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:textStyle="italic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>